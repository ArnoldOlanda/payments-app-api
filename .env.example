# ============================================================
# Payments App API — environment variables example
# Copy this file to .dev.env (local dev) or .prod.env (prod)
# and fill in the real values. NEVER commit real credentials.
# ============================================================

# ----- Server -----
PORT=3000
NODE_ENV=dev

# ----- Database (PostgreSQL) -----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=payments_app

# ----- Auth (JWT) -----
JWT_SECRET=change-me-in-prod-please-use-a-long-random-string
REFRESH_TOKEN_SECRET=change-me-too-in-prod-different-from-jwt

# ----- Password reset -----
# Deep link target for the mobile app (cobradores).
# For admins (web), use https://admin.yourdomain.com/reset-password
FRONTEND_RESET_URL=paymentsapp://reset-password
# Token lifetime in seconds (default: 3600 = 1 hour)
RESET_TOKEN_TTL_SECONDS=3600

RESEND_API_KEY=re_your_resend_api_key_here
MAIL_FROM="Payments App <onboarding@resend.dev>"